{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TaskWidget",
  "version": "0.1.0",
  "identifier": "com.taskwidget.app",
  "build": { "frontendDist": "../src" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "TaskWidget",
        "width": 300,
        "height": 400,
        "decorations": false,
        "transparent": true,
        "skipTaskbar": true,
        "resizable": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"]
  }
}
